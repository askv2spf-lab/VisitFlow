<!doctype html><html lang="uk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>VisitFlow</title><link rel="stylesheet" href="styles.css"><link rel="manifest" href="manifest.json"><script>window.EMBEDDED_STATE=null;</script></head><body><div class="shell"><aside><div class="brand"><img src="icons/icon-192.png"><div><b>VisitFlow</b><small>біобезпека відвідувань</small></div></div><nav><button class="active" data-tab="today">Сьогодні</button><button data-tab="visit">Запис</button><button data-tab="plan">План</button><button data-tab="matrix">Матриця / всі дільниці</button><button data-tab="help">Допомога</button><button data-tab="settings">Налаштування</button></nav></aside><main><header><h1 id="title">Сьогодні</h1><p id="now"></p></header>
<section id="tab-today" class="tab grid"><div class="card span-4"><h2>Дата</h2><b id="todayBig" class="big"></b><p id="cycleRange"></p></div><div class="card span-8"><h2>Стан на сьогодні</h2><div id="todayPeople" class="chips"></div></div><div class="card span-12"><h2>Поїздки на сьогодні</h2><div id="todayTrips" class="list"></div></div></section>
<section id="tab-visit" class="tab grid hidden"><div class="card span-12"><h2>Додати / редагувати факт</h2><div class="plan-row"><label>Дата<input type="date" id="visitDate"></label><label>Виробнича дільниця<div class="pick"><input id="visitSectionInput" autocomplete="off"><button type="button" id="visitSectionPick">Обрати</button></div><div id="visitSectionSuggest" class="suggest"></div></label><label>Працівник<div class="pick"><input id="visitWorkerInput" autocomplete="off"><button type="button" id="visitWorkerPick">Обрати</button></div><div id="visitWorkerSuggest" class="suggest"></div></label><label>Категорія<input id="visitCategory" readonly></label><button class="btn" id="visitOverrideBtn" type="button">Категорія / посадка</button><button class="btn primary" id="saveVisitBtn">Зберегти</button></div><div id="visitInfo" class="notice"></div></div><div class="card span-6"><h2>За дату</h2><div id="dayVisits" class="list"></div></div><div class="card span-6"><h2>Журнал</h2><input id="journalSectionFilter" placeholder="Фільтр"><div id="visitsTable" class="table"></div></div></section>
<section id="tab-plan" class="tab grid hidden"><div class="card span-12"><h2>Запланувати / редагувати</h2><div class="plan-row"><label>Дата<input type="date" id="planDate"></label><label>Виробнича дільниця<div class="pick"><input id="planSectionInput" autocomplete="off"><button type="button" id="planSectionPick">Обрати</button></div><div id="planSectionSuggest" class="suggest"></div></label><label>Працівник<div class="pick"><input id="planWorkerInput" autocomplete="off"><button type="button" id="planWorkerPick">Обрати</button></div><div id="planWorkerSuggest" class="suggest"></div></label><label>Категорія<input id="planCategory" readonly></label><button class="btn" id="planOverrideBtn" type="button">Категорія / посадка</button><button class="btn primary" id="addPlanBtn">Додати</button></div><div id="planInfo" class="notice"></div></div><div class="card span-12"><h2>План робіт</h2><div id="plans" class="list"></div></div></section>
<section id="tab-matrix" class="tab grid hidden"><div class="card span-12"><div class="head"><h2>Всі виробничі дільниці за датою</h2><input type="date" id="sectionsDate"><input id="sectionsFilter" placeholder="Фільтр виробничих дільниць"><button class="btn" id="dailyToggleBtn" type="button">Розгорнути по днях</button><button class="btn" id="dailyExportBtn" type="button">Експорт денної Excel</button><label class="btn">Імпорт денної Excel<input hidden type="file" id="dailyImportFile" accept=".xlsx,.xls"></label></div><div id="allSections" class="table"></div><div id="dailyCycle" class="table dailyCycle hidden"></div></div><div class="card span-12"><h2>Матриця</h2><div id="matrix" class="table matrixWrap"></div><div id="legend" class="legend"></div></div></section>

<section id="tab-help" class="tab grid hidden">
  <div class="card span-12 help-card"><h2>Допомога VisitFlow</h2><p class="muted">Цей розділ пояснює призначення кожної вкладки, поля, кнопки та службових повідомлень. VisitFlow працює як PWA-додаток: дані зберігаються у браузері, а циклограма та список працівників можуть автоматично підтягуватися з файлів у GitHub Pages.</p></div>
  <div class="card span-12 help-card"><h2>1. Загальна логіка роботи</h2><ol><li><b>Циклограма</b> визначає стан кожної виробничої дільниці на вибрану дату.</li><li><b>Матриця біобезпеки</b> перевіряє переходи між категоріями та показує найближчу дозволену дату.</li><li><b>План</b> — майбутні поїздки, <b>Запис</b> — фактичний журнал.</li><li><b>Обрані</b> працівники та дільниці показуються першими у списках вибору.</li></ol></div>
  <div class="card span-12 help-card"><h2>2. Вкладка «Сьогодні»</h2><ul><li><b>Дата</b> показує поточну дату та діапазон циклограми.</li><li><b>Стан на сьогодні</b> показує плани та факти на поточну дату.</li><li><b>Поїздки на сьогодні</b> дає змогу перенести план у журнал кнопкою «Записати в журнал».</li></ul></div>
  <div class="card span-12 help-card"><h2>3. Вкладка «Запис»</h2><ul><li><b>Дата</b> — дата фактичного відвідування.</li><li><b>Виробнича дільниця</b> та <b>Працівник</b> — поля пошуку з підказками і кнопкою «Обрати».</li><li><b>Категорія</b> заповнюється автоматично після вибору дільниці.</li><li><b>ДОЗВОЛЕНО / ЗАБОРОНЕНО</b> показує результат перевірки матриці.</li><li><b>Все одно додати</b> створює примусовий запис, який підсвічується як проблемний.</li></ul></div>
  <div class="card span-12 help-card"><h2>4. Вкладка «План»</h2><ul><li>Використовується для майбутніх поїздок.</li><li><b>Додати / Оновити</b> створює або редагує план.</li><li><b>Записати в журнал</b> переносить план у фактичні відвідування.</li><li><b>Ред.</b> — редагування, <b>×</b> — видалення плану.</li></ul></div>
  <div class="card span-12 help-card"><h2>5. Вкладка «Матриця / всі дільниці»</h2><ul><li><b>Всі виробничі дільниці за датою</b> показує стан дільниць на вибрану дату.</li><li><b>Фільтр</b> шукає за назвою, номером або категорією.</li><li><b>Матриця</b>: рядок — попередня категорія, стовпець — наступна. Значення 0/1/2/3 означають інтервал очікування, х/x — спеціальне правило.</li></ul></div>
  <div class="card span-12 help-card"><h2>6. Вкладка «Налаштування»</h2><ul><li><b>Тема</b> змінює кольори інтерфейсу.</li><li><b>Розмір тексту</b> дозволяє обрати компактний, стандартний, великий або дуже великий масштаб для мобільного перегляду.</li><li><b>Автопідвантаження</b> показує, чи знайдено <code>cycle.xlsx</code> та <code>workers.csv</code>.</li><li><b>Імпорти та експорти</b> — резервні копії, журнал CSV/Excel, працівники CSV, автономний HTML.</li><li><b>Працівники</b>: можна додати працівника, відкрити список у модальному вікні, знайти і видалити працівника без видалення історії журналу.</li><li><b>Обрані</b> — швидкий доступ до частих працівників і дільниць.</li></ul></div>
  <div class="card span-12 help-card"><h2>7. Типові ситуації</h2><ol><li>Якщо не підтягуються файли — перевірте, що <code>cycle.xlsx</code> і <code>workers.csv</code> лежать у корені репозиторію та назви збігаються з регістром.</li><li>Після оновлення на GitHub натисніть «Очистити кеш PWA» або зробіть hard refresh.</li><li>Якщо працівник заборонений для дільниці — дивіться поле «Доступно з».</li></ol></div>
</section>
<section id="tab-settings" class="tab grid hidden"><div class="card span-6"><h2>Тема</h2><select id="themeSelect"><option value="light">Світла</option><option value="dark">Темна</option><option value="warm">Тепла</option><option value="mint">М'ятна</option></select></div><div class="card span-6"><h2>Розмір тексту</h2><select id="textScaleSelect"><option value="compact">Компактний</option><option value="normal">Стандартний</option><option value="large">Великий</option><option value="xlarge">Дуже великий</option></select><p class="muted setting-note">Для мобільного перегляду. Змінює масштаб тексту без поломки сітки та полів.</p></div><div class="card span-6"><h2>Автопідвантаження</h2><div id="autoStatus" class="notice"></div></div><div class="card span-12"><details><summary class="btn primary">Імпорти та експорти</summary><div class="import-grid"><div class="import-card"><h3>Циклограма</h3><label class="btn">Обрати файл циклограми<input hidden type="file" id="cycleFile" accept=".xlsx,.xls"></label><button class="btn primary" id="importCycleBtn">Імпорт циклограми</button></div><div class="import-card"><h3>Працівники</h3><label class="btn">Обрати файл працівників<input hidden type="file" id="workersFile" accept=".csv,.xlsx,.xls"></label><button class="btn primary" id="importWorkersBtn">Імпорт працівників</button><button class="btn" id="workersTemplateBtn">Шаблон CSV</button></div><div class="import-card"><h3>Резервні копії та журнал</h3><button class="btn" id="exportJsonBtn">Експорт JSON</button><label class="btn">Імпорт JSON<input hidden type="file" id="importJsonInput" accept=".json"></label><button class="btn" id="exportVisitsCsvBtn">Експорт журналу CSV</button><button class="btn" id="exportVisitsXlsxBtn">Експорт журналу Excel</button><button class="btn" id="exportDailyXlsxBtn">Експорт денної циклограми Excel</button><label class="btn">Імпорт денної циклограми<input hidden type="file" id="importDailyXlsxInput" accept=".xlsx,.xls"></label><button class="btn" id="exportWorkersBtn">Експорт працівників CSV</button><button class="btn" id="saveHtmlBtn">Зберегти HTML з даними</button><button class="btn warn" id="clearCacheBtn">Очистити кеш PWA</button></div></div></details></div><div class="card span-6"><h2>Працівники</h2><div class="form"><input id="workerName" placeholder="ПІБ працівника"><button class="btn primary" id="addWorkerBtn">Додати</button><button class="btn" id="workersListBtn" type="button">Показати / редагувати список</button></div><div id="workersTable" class="table hidden"></div></div><div class="card span-6"><h2>Обрані</h2><button class="btn primary" id="favWorkersPick">Обрати працівників</button><div id="favWorkersList" class="chips"></div><button class="btn primary" id="favSectionsPick">Обрати виробничі дільниці</button><div id="favSectionsList" class="chips"></div></div></section></main></div><div id="modal" class="modal hidden"></div><script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script><script src="app.js?v=20"></script></body></html>